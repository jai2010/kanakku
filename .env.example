# Optional. The playground runs without an LLM (LLM_PROVIDER=fake).
# Set a real provider only if you want Accounting Studio to compile English into policy DSL.

# fake | openai | anthropic | xai | deepseek | omniroute | openai-compatible
LLM_PROVIDER=fake

# Required for every provider except fake.
# LLM_MODEL=grok-4

# LLM_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=

# LLM_BASE_URL=https://api.x.ai/v1
# LLM_TIMEOUT_MS=30000
